# Copy this file to .env and set a real password. Never commit .env.
TERMINAL_PASSWORD=change-me-to-a-long-random-password
# Idle timeout in minutes (no keyboard input).
IDLE_MINUTES=30
# Hard limit for a session in minutes.
MAX_SESSION_MINUTES=120

# --- Cloudflare Tunnel (optional) ---
# Token of a named tunnel from the Cloudflare Zero Trust dashboard.
# Leave empty to use a quick throwaway tunnel instead (see docker-compose.cloudflare.yml).
TUNNEL_TOKEN=

# --- STAR AI Terminal Copilot (OFF until gateway is deployed) ---
# Add these to the EXISTING terminal service on Railway.
AI_ENABLED=0
# The gateway service's private Railway internal URL, never a public website.
AI_GATEWAY_URL=http://star-ai-gateway.railway.internal:8081/answer
# Enter a shared, cryptographically random >=32-character token in Railway.
# It must match AI_GATEWAY_TOKEN in the isolated AI gateway service.
# AI_GATEWAY_TOKEN=

# The NEW, separate star-ai-gateway service owns provider secrets:
# AI_ENABLED=1
# AI_MODEL=<supported Responses API model id>
# AI_API_KEY=<provider key, do not place in terminal service>
# AI_GATEWAY_TOKEN=<same shared token>
# AI_MAX_PER_HOUR=30
