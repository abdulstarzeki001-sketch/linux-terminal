# Copy this file to .env and set a unique random password (24+ characters).
# The service will refuse to start with an empty password. Never commit .env.
TERMINAL_PASSWORD=
# Idle timeout in minutes (no keyboard input).
IDLE_MINUTES=30
# Hard limit for a session in minutes.
MAX_SESSION_MINUTES=120

# --- Cloudflare Tunnel (optional) ---
# Token of a named tunnel from the Cloudflare Zero Trust dashboard.
# Leave empty to use a quick throwaway tunnel instead (see docker-compose.cloudflare.yml).
TUNNEL_TOKEN=
