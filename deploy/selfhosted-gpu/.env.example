# Copy to .env ONLY ON THE GPU SERVER. Never commit real secrets.
# Public Qwen3.5-9B: default initial test on an NVIDIA GPU; adjust for VRAM.
HF_MODEL_ID=Qwen/Qwen3.5-9B
AI_MODEL_NAME=star-selfhost
MAX_MODEL_LEN=4096

# A long, random bearer token; use the SAME value for Railway AI_SELFHOST_API_KEY.
VLLM_API_KEY=replace-with-a-cryptographically-random-long-secret

# Named Cloudflare Tunnel token. Create through your own Cloudflare Zero Trust account.
CF_TUNNEL_TOKEN=replace-with-your-cloudflare-named-tunnel-token
